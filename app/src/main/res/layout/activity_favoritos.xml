<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis recursos favoritos"
            android:textColor="#263B70"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEstadoFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Aquí aparecerán tus recursos favoritos."
            android:textColor="#666666"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/contenedorFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnVolverFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Volver" />

    </LinearLayout>

</ScrollView>
