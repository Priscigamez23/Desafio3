<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar recurso"
            android:textColor="#263B70"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Completa la información del recurso educativo."
            android:textColor="#666666"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/edtTituloRecurso"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="Título del recurso"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtDescripcionRecurso"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Descripción"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Categoría"
            android:textColor="#263B70"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCategoriaRecurso"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="5dp" />

        <EditText
            android:id="@+id/edtEnlaceRecurso"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Enlace del recurso"
            android:inputType="textUri"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtAutorRecurso"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Nombre del autor"
            android:inputType="textCapWords"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnGuardarRecurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Guardar recurso" />

        <Button
            android:id="@+id/btnCancelarRecurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancelar" />

    </LinearLayout>

</ScrollView>
